{
  "name": "acton-citizens-band",
  "version": "1.0.0",
  "author": "Brian Morris",
  "private": true,
  "dependencies": {
    "firebase": "^9.22.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "three": "^0.151.3"
  },
  "scripts": {
    "startDev": "webpack serve --mode development --open",
    "start": "webpack serve --mode production --open",
    "buildDev": "webpack --mode development",
    "build": "webpack --mode production",
    "test": "node --test tests/*.test.mts",
    "typecheck": "tsc --noEmit && tsc --project tests/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.150.2",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "dotenv-webpack": "^8.0.1",
    "html-webpack-plugin": "^5.5.1",
    "mini-css-extract-plugin": "^2.7.5",
    "prettier": "^3.9.10",
    "sass": "^1.62.1",
    "sass-loader": "^13.2.2",
    "ts-loader": "^9.4.2",
    "typescript": "^5.9.3",
    "webpack": "^5.81.0",
    "webpack-cli": "^5.0.2",
    "webpack-dev-server": "^4.13.3"
  },
  "description": "Community website for the Acton Citizens' Band in Acton, Ontario.",
  "homepage": "https://actoncitizensband.ca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/actonband/Acton-Citizens-Band.git"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "type": "module"
}
