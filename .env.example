# Copy this file to .env and fill in your project's configuration.
# These values are embedded in the browser bundle. Never put server secrets here.
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id
REACT_APP_GOOGLE_ANALYTICS_TRACKING_ID=your-google-analytics-tracking-id


# Public URL used to load the Draco model decoder.
REACT_APP_DRACO_DECODER_URI=https://www.gstatic.com/draco/versioned/decoders/1.5.6/

# Development only: true/false overrides Firestore; blank follows Firestore.
# Production builds always follow features/account.enabled in Firestore.
REACT_APP_ACCOUNT_OVERRIDE=
