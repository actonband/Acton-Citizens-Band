{
  "hosting": {
    "site": "acton-citizens-band",
    "public": "build",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/AGENTS.md"],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "trailingSlash": true,
    "redirects": [
      {
        "source": "/calendar",
        "destination": "https://calendar.google.com/calendar/embed?src=94fded993db91a2a6d122b8aa105c80c99219e918f1c23d48bb2a74a11ebe34d%40group.calendar.google.com&ctz=America%2FToronto",
        "type": 302
      }
    ]
  }
}
